        <entry name="enableZoneSelector" type="Bool">
            <default>true</default>
        </entry>

        <entry name="zoneSelectorTriggerDistance" type="Int">
            <default>1</default>
        </entry>

        <entry name="enableZoneOverlay" type="Bool">
            <default>true</default>
        </entry>

        <entry name="zoneOverlayShowWhen" type="Int">
            <default>0</default>
        </entry>

        <entry name="zoneOverlayHighlightTarget" type="Int">
            <default>0</default>
        </entry>

        <entry name="zoneOverlayIndicatorDisplay" type="Int">
            <default>0</default>
        </entry>

        <entry name="enableSnapAssist" type="Bool">
            <default>true</default>
        </entry>

        <entry name="enableStickyResizing" type="Bool">
            <default>true</default>
        </entry>

